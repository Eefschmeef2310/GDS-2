[sub_resource type="GDScript" id="GDScript_4fa2r"]
script/source = "extends Node3D

var cs = [\"6ceded\", \"6cb9c9\", \"6d85a5\", \"6e5181\", \"6f1d5c\", \"4f1446\", \"2e0a30\", \"0d001a\"]

func _ready():
	for rock in get_children():
		var mesh : MeshInstance3D = rock.get_child(0)
		mesh.material_override.albedo_color = cs.pick_random()
"

[sub_resource type="GDScript" id="GDScript_qhrui"]
script/source = "extends Sprite3D

var base_y
var t = 0

func _ready():
	base_y = position.y

func _process(delta: float) -> void:
	t = wrap(t + delta*2, 0, 360)
	position.y = base_y + (2.5* sin(t))
"

